# App
APP_ENV=production
APP_NAME=agent-system

# Server
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/agentdb

# LLM
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aicredits.in/v1
DEFAULT_OPENAI_MODEL=gpt-5-mini
GITHUB_TOKEN=

# Bounded iterative research
RESEARCH_MAX_ITERATIONS=2
RESEARCH_MAX_TOOL_CALLS=8
RESEARCH_MAX_SECONDS=180
RESEARCH_MAX_REPEAT_STEPS=1

# Logging
LOG_LEVEL=info
